@startuml
title Create Reservation (POST /api/v1/coworkingspaces/:coworkingSpaceId/reservations)

actor User
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:coworkingspaces" as csRouter
participant "<<router>>\n:reservations" as resRouter
participant "<<middleware>>\n:auth" as auth
participant "<<controllers>>\n:reservations" as controller
participant "<<model>>\n:CoworkingSpace" as csModel
participant "<<model>>\n:Reservation" as resModel
database "<<MongoDB>>\n:coworkingspaces" as csDB
database "<<MongoDB>>\n:reservations" as resDB

User -> server ++ : req.post('/api/v1/coworkingspaces/:coworkingSpaceId/reservations')
server -> csRouter ++ : app.use('/api/v1/coworkingspaces', coworkingspaces)
csRouter -> resRouter ++ : router.use('/:coworkingSpaceId/reservations', reservationRouter)
resRouter -> auth ++ : protect(), authorize('admin','user')
auth --> resRouter -- : req.user
resRouter -> controller ++ : addReservation()

controller -> csModel ++ : findById(coworkingSpaceId)
csModel -> csDB ++ : CoworkingSpaceSchema
csDB --> csModel -- : coworkingSpace
csModel --> controller -- : coworkingSpace

alt coworking space not found
  controller --> User : 400 No coworking space with the id
end

controller -> resModel ++ : find({user : req.user.id})
resModel -> resDB ++ : ReservationSchema
resDB --> resModel -- : existedReservation
resModel --> controller -- : existedReservation

alt user already has 3 reservations (not admin)
  controller --> User : 400 already made 3 reservations
end

controller -> resModel ++ : create(req.body)
resModel -> resDB ++ : ReservationSchema
resDB --> resModel -- : reservation
resModel --> controller -- : reservation

controller --> resRouter -- : response
resRouter --> csRouter --
csRouter --> server --
server --> User -- : 201 {success : true, data : reservation}
@enduml
