      "item": [
        {
          "name": "Get All Hospitals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nconst response = pm.response.json();\r\n\r\nconsole.log(response);\r\n\r\npm.test(\"There are some hospitals!!\", () => {\r\n    pm.expect(response.count).to.be.above(0);\r\n})\r\n\r\npm.execution.setNextRequest(\"Create New Hospital\");"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.get(\"URL\");\r\nconsole.log(\"login url:\", base + \"/api/v1/auth/login\");\r\n\r\npm.sendRequest({\r\n  url: base + \"/api/v1/auth/login\",\r\n  method: \"POST\",\r\n  header: { \"Content-Type\": \"application/json\" },\r\n  body: { mode: \"raw\", raw: JSON.stringify({ email: \"admin@gmail.com\", password: \"12345678\" }) }\r\n}, (err, res) => {\r\n  console.log(\"login err:\", err, \"status:\", res && res.code);\r\n  const token = res && res.json().token;\r\n  console.log(\"token set:\", !!token);\r\n  pm.variables.set(\"TOKEN\", token);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{URL}}/api/v1/hospitals",
              "host": [
                "{{URL}}"
              ],
